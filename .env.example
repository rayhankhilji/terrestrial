# Copy to .env and fill in. Never commit .env.

# Global Fishing Watch API token (required for the fetch stage)
# Register (free, non-commercial): https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=

# Featherless.ai API key (optional: enables AI analyst briefs in the pipeline)
# https://featherless.ai
FEATHERLESS_API_KEY=
# Optional override of the Featherless model id (see pipeline/config.py for the default)
FEATHERLESS_MODEL=

# TuringDB server (docker compose up -d turingdb)
TURINGDB_URL=http://localhost:6666
