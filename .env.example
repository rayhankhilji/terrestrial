# Copy to .env and fill in. Never commit .env.

# Global Fishing Watch API token (required for the fetch stage)
# Register (free, non-commercial): https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=

# Featherless.ai API key (optional: enables AI analyst briefs in the pipeline)
# https://featherless.ai
FEATHERLESS_API_KEY=
# Optional override of the Featherless model id (see pipeline/config.py for the default)
FEATHERLESS_MODEL=

# TuringDB server (docker compose up -d turingdb)
TURINGDB_URL=http://localhost:6666

# --- Live layer (optional; each source runs only if its key is set) ---
# aisstream.io live AIS websocket (free; sign in with GitHub): https://aisstream.io/apikeys
AISSTREAM_API_KEY=
# NASA FIRMS thermal anomalies (free MAP_KEY by email): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Predictive layer ---
# TypeSafe AI (Jev decision model): https://docs.typesafe.ai
TYPESAFE_API_KEY=
# Kaggle API (missile-attacks dataset): kaggle.com → Settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional: alerts.in.ua live air-raid alerts token (request at https://alerts.in.ua/api-request)
ALERTS_IN_UA_TOKEN=
